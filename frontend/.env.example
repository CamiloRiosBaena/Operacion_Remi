# ── Copia este archivo como .env y rellena los valores ──────

# ── Supabase ─────────────────────────────────────────────────
# Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=          # https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=     # anon / public key

# ── API backend ────────────────────────────────────────────
VITE_API_URL=http://localhost:3000/api

# ── Web Push (VAPID) ───────────────────────────────────────
# Misma clave pública generada en el backend con: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# ── Wompi (widget de pago) ──────────────────────────────────
VITE_WOMPI_WIDGET_URL=https://checkout.wompi.co/widget.js

# ── URL pública del frontend ────────────────────────────────
VITE_APP_URL=http://localhost:5173
