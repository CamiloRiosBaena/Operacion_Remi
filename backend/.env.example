# ── Copia este archivo como .env y rellena los valores ──────

# ── PostgreSQL via Supabase ──────────────────────────────────
# Supabase Dashboard > Settings > Database
DB_HOST=          # aws-x-us-east-x.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=          # postgres.<project-ref>
DB_PASSWORD=      # contraseña del proyecto en Supabase
DB_SSL=true

# ── App ─────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── JWT ─────────────────────────────────────────────────────
JWT_SECRET=       # cadena larga y aleatoria
JWT_EXPIRES_IN=7d

# ── Supabase ─────────────────────────────────────────────────
# Supabase Dashboard > Settings > API
SUPABASE_URL=            # https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=       # anon / public key
SUPABASE_SERVICE_ROLE=   # service_role key (nunca expongas esto en el frontend)

# ── Mercado Pago ─────────────────────────────────────────────
# developers.mercadopago.com > Credenciales de prueba o producción
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# URL base del frontend (usada en back_urls de MP)
APP_URL=http://localhost:5173

# ── Web Push (VAPID) ─────────────────────────────────────────
# Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@operacionremi.com

# ── Groq (chatbot asistente) ──────────────────────────────────
# console.groq.com → API Keys
GROQ_API_KEY=
